  optsDiv.innerHTML = `<div class="option-row">` + chosenTools.map(t=>`
    <div class="opt ${state.toolChosen===t.key?'selected':''}" onclick="chooseFinalTool('${t.key}')">${t.emoji} ${t.label}</div>`).join('') + `</div>`;
