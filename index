  renderChoose();
  saveState();
}

/* ---------- diapositiva 13: escenario ---------- */
function renderScenario(){
  const optsDiv = document.getElementById('scenario-options');
  optsDiv.innerHTML = `<div class="option-row">` + SCENARIO_OPTIONS.map(o=>`
    <div class="opt ${state.scenarioAnswer===o.key?'selected':''}" onclick="answerScenario('${o.key}')">${o.label}</div>`).join('') + `</div>`;
  document.getElementById('scenario-feedback').innerHTML = state.scenarioAnswer
    ? '<p class="feedback ok">Buena elección — de hecho, pueden funcionar varias de estas estrategias juntas.</p>' : '';
}
function answerScenario(key){
  state.scenarioAnswer = key;
  renderScenario();
  saveState();
}

/* ---------- diapositiva 16: emoji combo de cierre ---------- */
function renderFinal(){
  const palette = document.getElementById('emoji-palette');
  palette.innerHTML = EMOJI_PALETTE.map(e=>`<button onclick="addEmoji('${e}')">${e}</button>`).join('');
  updateEmojiPreview();
}
function addEmoji(e){
  if((state.emojiCombo.match(/./gu)||[]).length >= 6) return;
  state.emojiCombo += e;
  updateEmojiPreview();
  saveState();
}
function clearEmojiCombo(){
  state.emojiCombo = '';
  updateEmojiPreview();
  saveState();
}
function updateEmojiPreview(){
  const el = document.getElementById('emoji-combo-preview');
  el.textContent = state.emojiCombo ? state.emojiCombo : 'Toca emojis para armar tu combinación';
}
/* ---------- screen enter hooks ---------- */
const originalRender = render;
render = function(screenId){
  originalRender(screenId);
  if(screenId==='s1-body') renderZones();
  if(screenId==='s1-feel') renderFeel();
  if(screenId==='s2-wave') renderWave();
  if(screenId==='s2b-safenet') renderSafenet();
  if(screenId==='s2c-alert') renderAlert();
  if(screenId==='s3-grounding') renderGrounding();
  if(screenId==='s3b-checkin') renderCheckin();
  if(screenId==='s3-breathing') renderBreathing();
  if(screenId==='s4-toolbox') renderToolbox();
  if(screenId==='s4b-choose') renderChoose();
  if(screenId==='s4c-scenario') renderScenario();
  if(screenId==='final') renderFinal();
};

/* ---------- fuegos artificiales (diapositiva 16 / "final") ---------- */
let fwAnimId = null;
let fwStopTimeout = null;
function playFireworks(){
  const canvas = document.getElementById('fireworks-canvas');
  const ctx = canvas.getContext('2d');
  const DPR = Math.min(window.devicePixelRatio || 1, 2);

  function resize(){
    canvas.width = window.innerWidth * DPR;
    canvas.height = window.innerHeight * DPR;
    canvas.style.width = window.innerWidth + 'px';
    canvas.style.height = window.innerHeight + 'px';
    ctx.setTransform(DPR,0,0,DPR,0,0);
  }
  resize();
  window.addEventListener('resize', resize);

  const colors = ['#F2A65A','#2A9D8F','#EAF5F3','#F2E863','#F26A6A','#9D8FF2','#6AC3F2'];
  let particles = [];

  function spawnBurst(x, y){
    const count = 34 + Math.floor(Math.random()*14);
    const color = colors[Math.floor(Math.random()*colors.length)];
    for(let i=0;i<count;i++){
      const angle = (Math.PI*2*i)/count + Math.random()*0.2;
      const speed = 1.6 + Math.random()*3.2;
      particles.push({
        x, y,
        vx: Math.cos(angle)*speed,
        vy: Math.sin(angle)*speed,
        life: 1,
        decay: 0.012 + Math.random()*0.012,
        color,
        size: 1.5 + Math.random()*2
      });
    }
  }

  let burstInterval = setInterval(()=>{
    const w = window.innerWidth, h = window.innerHeight;
    spawnBurst(w*(0.15+Math.random()*0.7), h*(0.15+Math.random()*0.55));
  }, 450);
  // ráfaga inicial para que arranque con fuerza
  spawnBurst(window.innerWidth*0.3, window.innerHeight*0.35);
  spawnBurst(window.innerWidth*0.7, window.innerHeight*0.3);

  function tick(){
    ctx.clearRect(0,0,window.innerWidth,window.innerHeight);
    particles.forEach(p=>{
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.035; // gravedad suave
      p.life -= p.decay;
    });
    particles = particles.filter(p=>p.life>0);
    particles.forEach(p=>{
      ctx.globalAlpha = Math.max(p.life,0);
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
      ctx.fill();
    });
    ctx.globalAlpha = 1;
    fwAnimId = requestAnimationFrame(tick);
  }

  canvas.classList.add('show');
  if(fwAnimId) cancelAnimationFrame(fwAnimId);
  tick();

  clearTimeout(fwStopTimeout);
  fwStopTimeout = setTimeout(()=>{
    clearInterval(burstInterval);
  }, 4200); // deja de generar nuevas ráfagas antes de los ~5s totales

  setTimeout(()=>{
    canvas.classList.remove('show');
    setTimeout(()=>{
      cancelAnimationFrame(fwAnimId);
      fwAnimId = null;
      particles = [];
      ctx.clearRect(0,0,canvas.width,canvas.height);
      window.removeEventListener('resize', resize);
    }, 400);
  }, 5000);
}

/* dispara los fuegos artificiales cada vez que se entra a la diapositiva 16 */
const renderWithFireworks = render;
render = function(screenId){
  renderWithFireworks(screenId);
  if(screenId==='final') playFireworks();
};

