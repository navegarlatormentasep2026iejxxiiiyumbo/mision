  emojiCombo:'', supportContext:'flow',
  history:[]
};
let currentScreen = 'intro';

/* ---------- storage helpers ---------- */
async function saveState(){
  try{ await window.storage.set('progreso', JSON.stringify(state), false); }catch(e){ console.warn('save failed', e); }
}
async function loadState(){
  try{
    const r = await window.storage.get('progreso', false);
    if(r && r.value){ state = Object.assign(state, JSON.parse(r.value)); }
  }catch(e){ /* no saved progress yet */ }
}

/* ---------- navigation ---------- */
function goTo(screenId){
  state.history.push(currentScreen);
  render(screenId);
}
function render(screenId){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('visible'));
  const el = document.querySelector(`[data-screen="${screenId}"]`);
  if(el) el.classList.add('visible');
  currentScreen = screenId;
  updateProgress();
  document.body.setAttribute('data-bg', screenId);
  document.getElementById('help-fab').classList.toggle('show', !['intro','support','final','toc'].includes(screenId));
  saveState();
  window.scrollTo(0,0);
}
function updateProgress(){
  /* 'toc' (tabla de contenido) no es parte del recorrido: no tocamos ni los puntos
     ni la línea, se quedan mostrando la última posición real dentro de la misión */
  if(currentScreen==='toc') return;
  /* 'support' abierta como atajo desde el botón de ayuda (❓) es una CONSULTA puntual,
     no un avance real en la misión: no debe hacer que la barra "salte" hacia el final */
  if(currentScreen==='support' && state.supportContext==='help') return;

  const idx = STATION_MAP[currentScreen];
  const bar = document.getElementById('progress');
  bar.innerHTML = STATION_ICONS.map((ic,i)=>{
    let cls = 'dot';
    if(i===idx) cls+=' active';
    else if(idx>-1 && i<idx) cls+=' done';
    return `<div class="${cls}">${ic}</div>`;
  }).join('');
  /* la línea de avance se mueve por cada diapositiva del recorrido (no solo por sección),
     así se nota el avance al pasar de una diapositiva a la siguiente */
  const flowIdx = STATIONS.indexOf(currentScreen);
  if(currentScreen==='intro'){
    document.getElementById('track-fill').style.width = '0%';
  } else if(flowIdx>-1){
    const pct = ((flowIdx+1)/STATIONS.length)*100;
    document.getElementById('track-fill').style.width = pct+'%';
  }
}
function startMission(){ goTo('s0-objetivos'); }
function restartMission(){
  state = {
    zones:{}, feltEmotion:null,
    waveAnswer:null, safeNetwork:[], alertSigns:[],
    grounding:{5:false,4:false,3:false,2:false,1:false}, checkinAnswer:null, breathingDone:false,
    toolboxSelected:[], toolChosen:null, scenarioAnswer:null,
    emojiCombo:'', supportContext:'flow',
    history:[]
  };
  render('intro');
}
function goBack(){
  if(typeof breathTimerInterval !== 'undefined'){ clearInterval(breathTimerInterval); }
  const prev = state.history.pop() || 'intro';
  render(prev);
}

/* ---------- help / rutas de apoyo (diapositiva 15) ---------- */
function openHelp(){
  state.supportContext = 'help';
  document.getElementById('support-tag').textContent = 'Rutas de apoyo';
  document.getElementById('btn-support-action').textContent = 'Volver';
  document.getElementById('btn-support-back').style.display = 'none';
  goTo('support');
}
function goToSupportFromFlow(){
  state.supportContext = 'flow';
  document.getElementById('support-tag').textContent = 'Diapositiva 15';
  document.getElementById('btn-support-action').textContent = 'Continuar ➡';
  document.getElementById('btn-support-back').style.display = '';
  goTo('support');
}
function continueFromSupport(){
  if(state.supportContext === 'help'){
    const prev = state.history.pop() || 'intro';
    render(prev);
  } else {
    goTo('final');
  }
}

/* ---------- diapositiva 3 (parte 1): body map ---------- */
function renderZones(){
  ZONES.forEach(z=>{
    const btn = document.getElementById('zone-'+z.key);
    if(state.zones[z.key]) btn.classList.add('done');
  });
  const count = Object.keys(state.zones).length;
  document.getElementById('zone-counter').textContent = `${count} de 5 zonas exploradas`;
}
function openZone(key){
  const zone = ZONES.find(z=>z.key===key);
  const modal = document.getElementById('modal-content');
  modal.innerHTML = `
    <h3>${zone.label}</h3>
    <p>${zone.text}</p>
    <p style="font-size:.85rem;font-weight:600;">¿Has experimentado alguna vez una sensación relacionada con esta zona?</p>
    <div class="option-row">
      ${ZONE_OPTS.map((o)=>`<div class="opt" onclick="chooseZoneOpt('${key}','${o}')">${o}</div>`).join('')}
    </div>`;
  document.getElementById('modal-backdrop').classList.add('visible');
}
function chooseZoneOpt(key, opt){
  state.zones[key] = opt;
  document.getElementById('modal-backdrop').classList.remove('visible');
  renderZones();
  saveState();
}

/* ---------- diapositiva 3 (parte 2): elige una emoción ---------- */
function renderFeel(){
  const grid = document.getElementById('emotion-grid');
  grid.innerHTML = EMOTIONS.map(e=>`
    <div class="emotion-chip ${state.feltEmotion===e.key?'selected':''}" onclick="chooseEmotion('${e.key}')">
      ${e.emoji}<small>${e.name}</small>
    </div>`).join('');
}
function chooseEmotion(key){
  state.feltEmotion = key;
  const e = EMOTIONS.find(x=>x.key===key);
  const modal = document.getElementById('modal-content');
  modal.innerHTML = `<h3>${e.emoji} ${e.name}</h3><p>${e.text}</p><button class="btn" onclick="closeModal()">Cerrar</button>`;
  document.getElementById('modal-backdrop').classList.add('visible');
  renderFeel();
  saveState();
}
function closeModal(){ document.getElementById('modal-backdrop').classList.remove('visible'); }

/* ---------- diapositiva 5: ola emocional ---------- */
function renderWave(){
  const optsDiv = document.getElementById('wave-options');
  optsDiv.innerHTML = WAVE_OPTIONS.map(o=>`
    <div class="poll-opt ${state.waveAnswer===o.key?'selected':''}" onclick="answerWave('${o.key}')">${o.label}</div>`).join('');
}
function answerWave(key){
  state.waveAnswer = key;
  renderWave();
  saveState();
}

/* ---------- diapositiva 6: red segura ---------- */
function renderSafenet(){
  const grid = document.getElementById('safenet-grid');
  grid.innerHTML = SAFENET.map(s=>`
    <div class="tool-card ${state.safeNetwork.includes(s.key)?'selected':''}" onclick="toggleSafenet('${s.key}')">
      <span class="emoji">${s.emoji}</span>${s.label}
    </div>`).join('');
}
function toggleSafenet(key){
  const idx = state.safeNetwork.indexOf(key);
