      <span class="emoji">${s.emoji}</span>${s.label}
    </div>`).join('');
}
function toggleAlert(key){
  const idx = state.alertSigns.indexOf(key);
  if(idx>-1){ state.alertSigns.splice(idx,1); } else { state.alertSigns.push(key); }
  renderAlert();
  saveState();
}

/* ---------- diapositiva 8: grounding 5-4-3-2-1 ---------- */
function renderGrounding(){
  const list = document.getElementById('grounding-list');
  list.innerHTML = GROUNDING.map(g=>`
    <label class="check-item">
      <input type="checkbox" ${state.grounding[g.n]?'checked':''} onchange="toggleGround(${g.n}, this.checked)">
      <span>${g.icon} ${g.text}</span>
