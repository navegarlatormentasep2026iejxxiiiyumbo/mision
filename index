/* ---------- diapositiva 9: check-in ---------- */
function renderCheckin(){
  const optsDiv = document.getElementById('checkin-options');
  optsDiv.innerHTML = `<div class="option-row">` + CHECKIN_OPTIONS.map(o=>`
    <div class="opt ${state.checkinAnswer===o.key?'selected':''}" onclick="answerCheckin('${o.key}')">${o.label}</div>`).join('') + `</div>`;
}
function answerCheckin(key){
  state.checkinAnswer = key;
  renderCheckin();
  saveState();
}

/* ---------- diapositiva 10: respiración ---------- */
let breathTimerInterval = null;
function renderBreathing(){
  let seconds = 120;
  clearInterval(breathTimerInterval);
  const timerEl = document.getElementById('breath-timer');
  timerEl.textContent = '02:00';
  breathTimerInterval = setInterval(()=>{
    seconds--;
    const m = String(Math.floor(seconds/60)).padStart(2,'0');
    const s = String(seconds%60).padStart(2,'0');
    timerEl.textContent = `${m}:${s}`;
    if(seconds<=0){
      clearInterval(breathTimerInterval);
      timerEl.textContent = '00:00';
      state.breathingDone = true;
      saveState();
    }
  },1000);
}

