  const grid = document.getElementById('tool-grid');
  grid.innerHTML = TOOLS.map(t=>`
    <div class="tool-card ${state.toolboxSelected.includes(t.key)?'selected':''}" onclick="toggleTool('${t.key}')">
      <span class="emoji">${t.emoji}</span>${t.label}
