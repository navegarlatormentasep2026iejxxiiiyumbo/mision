  document.getElementById('tool-counter').textContent = `${state.toolboxSelected.length} de 3 seleccionadas`;
}
function toggleTool(key){
  const idx = state.toolboxSelected.indexOf(key);
  if(idx>-1){ state.toolboxSelected.splice(idx,1); }
  else if(state.toolboxSelected.length<3){ state.toolboxSelected.push(key); }
